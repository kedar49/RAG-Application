# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai
COLLECTION_NAME=rag_documents_v2

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Models ────────────────────────────────────────────────────────────────────
# Generation model options (pick one):
#   qwen2.5:7b        → Best quality, ~4.7GB VRAM  [RECOMMENDED]
#   gemma3:4b         → Lighter, 128K ctx, ~3.3GB
#   qwen2.5:3b        → Smallest, ~2GB, if very limited resources
GENERATION_MODEL=qwen2.5:7b

# Validation / orchestration model (reasoning tasks, needs to be lighter):
#   phi4-mini:3.8b    → Best reasoning at ~3.8B size  [RECOMMENDED]
#   qwen2.5:3b        → Fallback if phi4-mini unavailable
VALIDATION_MODEL=phi4-mini:3.8b

# Embedding model — always use a dedicated embedder, NOT the chat model
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# ── Anti-Hallucination ────────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.60
GENERATION_TEMPERATURE=0.1

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
